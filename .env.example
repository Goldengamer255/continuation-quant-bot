# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.  `.env` is gitignored.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# Create the API key with TRADE permission only. Never enable WITHDRAWAL on a
# key used by a bot, and IP-whitelist it if the exchange supports that.
# -----------------------------------------------------------------------------

EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here
# Some venues (OKX, KuCoin, Coinbase) require a passphrase as a third secret.
EXCHANGE_API_PASSWORD=

# Second arming key for live trading. The engine refuses to send real orders
# unless config has `execution.mode: live` AND this is exactly YES.
CQB_LIVE_TRADING=NO

# Optional: point at a different config file than config/settings.yaml.
# CQB_CONFIG=config/settings.yaml
